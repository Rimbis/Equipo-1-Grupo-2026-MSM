{
  "installCommand": "npm ci",
  "buildCommand": "VITE_API_URL= npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://biblioteca-tecnica-msm-api.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

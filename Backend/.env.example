PORT=4000

# Copiar la URI completa desde Supabase > Connect > Session pooler.
# Si la contraseña contiene caracteres especiales, deben estar codificados para URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# URL del frontend (CORS), sin barra final. Varias separadas por coma.
# Local: http://localhost:5173   Producción: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Clave para firmar los tokens. Generar una larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usuario del bibliotecario y el HASH (no la contraseña) de su clave. Generar el hash con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CONTRASEÑA', 10))"
# Ponerlo entre comillas simples porque contiene signos $
BIBLIOTECARIO_USER=bibliotecario
BIBLIOTECARIO_PASSWORD_HASH=''
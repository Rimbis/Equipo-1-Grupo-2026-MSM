{
  "version": 2,
  "buildCommand": "npm install && cd Frontend && npm install && npm run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "Backend/**"
    }
  }
}
